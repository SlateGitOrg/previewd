# Environment read by `previewd serve` (secrets come from the environment or
# files, never from flags). Copy to .env for local experiments; never commit .env.

# One or more webhook HMAC secrets, comma-separated (rotation: list new and old).
# Each must be at least 16 characters.
PREVIEWD_WEBHOOK_SECRETS=replace-with-a-long-random-secret

# Token with commit-status write access. Leave empty to only log statuses.
GITHUB_TOKEN=

# Optional: kubeconfig used when running outside a cluster.
KUBECONFIG=
